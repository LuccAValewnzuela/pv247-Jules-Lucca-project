# Database (SQLite via libSQL)
# Local dev: a file on disk. Production (Vercel): your Turso database URL
# (https://turso.tech) — libsql://<your-db>.turso.io — plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:local.db
# Turso auth token — only needed for a remote Turso DB, not for local dev
DATABASE_AUTH_TOKEN=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Local dev URL; in production set to your Vercel URL
AUTH_URL=http://localhost:3000

# Google SSO credentials (Google Cloud Console → OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (email notifications) — https://resend.com/api-keys
RESEND_API_KEY=

# Public base URL of the app (used in emails, QR codes, calendar feed links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
